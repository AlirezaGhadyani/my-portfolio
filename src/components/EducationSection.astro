---
import type { EducationItem, Certification } from '../data/schema.ts';

interface Props {
	education: EducationItem[];
	certifications?: Certification[];
}

const { education, certifications = [] } = Astro.props;
---

<section id="education" aria-labelledby="education-title" class="education-section">
	<div class="section-header">
		<div class="section-tag">Credentials & Learning</div>
		<h2 id="education-title" class="section-title">Education & Certifications</h2>
	</div>

	<div class="edu-grid">
		<!-- Degrees -->
		<div class="edu-column">
			<h3 class="column-subtitle">Academic Background</h3>
			<div class="edu-blocks">
				{
					education.map((item) => (
						<article class="edu-card">
							<div class="edu-head">
								<div>
									<h4 class="edu-institution">{item.institution}</h4>
									<p class="edu-degree">
										{item.degree} in {item.field}
									</p>
								</div>
								<span class="edu-dates">
									{item.startDate} — {item.endDate}
								</span>
							</div>
							{item.honors && (
								<p class="edu-honors">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
									</svg>
									<span>{item.honors}</span>
								</p>
							)}
						</article>
					))
				}
			</div>
		</div>

		<!-- Certifications -->
		{certifications.length > 0 && (
			<div class="edu-column">
				<h3 class="column-subtitle">Professional Certifications</h3>
				<ul class="cert-list">
					{
						certifications.map((cert) => (
							<li class="cert-card">
								<div class="cert-head">
									{cert.url ? (
										<a href={cert.url} target="_blank" rel="noreferrer noopener" class="cert-link">
											<span>{cert.name}</span>
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<line x1="7" y1="17" x2="17" y2="7"></line>
												<polyline points="7 7 17 7 17 17"></polyline>
											</svg>
										</a>
									) : (
										<span class="cert-name">{cert.name}</span>
									)}
									<span class="cert-date">{cert.date}</span>
								</div>
								<p class="cert-issuer">{cert.issuer}</p>
							</li>
						))
					}
				</ul>
			</div>
		)}
	</div>
</section>

<style>
	.education-section {
		scroll-margin-top: 6rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.section-header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--text);
		margin: 0;
	}

	.edu-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	@media (max-width: 48rem) {
		.edu-grid { grid-template-columns: 1fr; }
	}

	.edu-column {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.column-subtitle {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.edu-blocks,
	.cert-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.edu-card,
	.cert-card {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		padding: 1.75rem;
		background: linear-gradient(145deg, var(--surface), color-mix(in srgb, var(--surface) 78%, var(--bg)));
		box-shadow: var(--shadow-sm);
		transition: var(--transition-fast);

		&:hover {
			border-color: var(--border-active);
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
		}
	}

	.edu-head,
	.cert-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;

		.edu-institution,
		.cert-name {
			font-size: 1.05rem;
			font-weight: 700;
			color: var(--text);
			margin: 0;
		}

		.cert-link {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			font-size: 1.05rem;
			font-weight: 700;
			color: var(--text);
			text-decoration: none;

			svg {
				color: var(--text-subtle);
				transition: transform 0.2s ease, color 0.2s ease;
			}

			&:hover {
				color: var(--accent);

				svg {
					color: var(--accent);
					transform: translate(2px, -2px);
				}
			}
		}

		.edu-dates,
		.cert-date {
			color: var(--text-muted);
			font-family: var(--font-mono);
			font-size: 0.8rem;
			background: var(--surface-muted);
			padding: 0.2rem 0.5rem;
			border-radius: var(--radius-sm);
			white-space: nowrap;
			border: 1px solid var(--border-subtle);
		}
	}

	.edu-degree {
		color: var(--accent);
		font-size: 0.925rem;
		font-weight: 550;
		margin: 0.35rem 0 0 0;
	}

	.edu-honors {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--text-muted);
		font-size: 0.85rem;
		margin: 0.75rem 0 0 0;
		padding-top: 0.5rem;
		border-top: 1px solid var(--border-subtle);

		svg {
			color: hsl(45 95% 50%);
		}
	}

	.cert-issuer {
		color: var(--text-muted);
		font-size: 0.875rem;
		margin: 0.35rem 0 0 0;
	}
</style>

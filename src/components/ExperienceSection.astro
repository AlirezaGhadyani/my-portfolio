---
import { dateRange, orderedExperience } from "../domain/present.ts";
import type { ExperienceItem } from "../data/schema.ts";
import SectionHeader from "./SectionHeader.astro";

interface Props {
	items: ExperienceItem[];
}

const { items } = Astro.props;

const ordered = orderedExperience(items);
---

<section id="experience" aria-labelledby="experience-title" class="experience-section">
	<SectionHeader tag="Career History" title="Work Experience" id="experience-title" />

	<div class="timeline-container">
		<ol class="timeline-list">
			{
				ordered.map((item) => (
					<li class="timeline-item">
						<div class="timeline-marker" aria-hidden="true">
							<span class="marker-dot" />
						</div>
						<article class:list={["experience-card", { "experience-card--primary": item.tier === "primary" }]}>
							<div class="experience-head">
								<div>
									<h3 class="experience-role">{item.role}</h3>
									<p class="experience-company">
										<span class="company-name">{item.company}</span>
										<span class="sep">•</span>
										<span class="location">{item.location}</span>
									</p>
								</div>
								<div class="date-badge">
									<svg
										width="13"
										height="13"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true">
										<rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
										<line x1="16" y1="2" x2="16" y2="6" />
										<line x1="8" y1="2" x2="8" y2="6" />
										<line x1="3" y1="10" x2="21" y2="10" />
									</svg>
									<span>{dateRange(item.startDate, item.endDate)}</span>
								</div>
							</div>

							<p class="experience-summary">{item.summary}</p>

							{item.highlights.length > 0 && (
								<ul class="experience-highlights">
									{item.highlights.map((highlight) => (
										<li>
											<span class="bullet" aria-hidden="true">
												▹
											</span>
											<span>{highlight}</span>
										</li>
									))}
								</ul>
							)}

							{item.technologies && item.technologies.length > 0 && (
								<div class="experience-tech">
									<span class="tech-label">Stack:</span>
									<ul class="tech-tags">
										{item.technologies.map((tech) => (
											<li class="tech-tag">{tech}</li>
										))}
									</ul>
								</div>
							)}
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.experience-section {
		scroll-margin-top: 6rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.timeline-container {
		position: relative;
	}

	.timeline-list {
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;

		&::before {
			content: "";
			position: absolute;
			top: 1.5rem;
			bottom: 1.5rem;
			left: 0.625rem;
			width: 2px;
			background: var(--border);
		}
	}

	.timeline-item {
		position: relative;
		display: flex;
		gap: 1.5rem;
	}

	.timeline-marker {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: flex-start;
		padding-top: 1.35rem;
		flex-shrink: 0;

		.marker-dot {
			width: 0.875rem;
			height: 0.875rem;
			border-radius: var(--radius-full);
			background: var(--surface);
			border: 2px solid var(--accent);
			box-shadow: 0 0 0 3px var(--bg);
			transition:
				transform 0.2s ease,
				background-color 0.2s ease;
		}
	}

	.timeline-item:hover .marker-dot {
		background: var(--accent);
		transform: scale(1.25);
	}

	.experience-card {
		flex: 1;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: clamp(1.5rem, 3vw, 2.5rem);
		box-shadow: var(--shadow-sm);
		border-left: 2px solid var(--accent);
		background: color-mix(in srgb, var(--surface) 58%, transparent);
		transition: var(--transition-fast);

		&:hover {
			border-color: var(--border-active);
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
		}
	}
	.experience-card--primary {
		background: var(--surface);
		box-shadow: var(--shadow-md);
	}

	.experience-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;

		.experience-role {
			font-size: clamp(1.15rem, 2vw, 1.4rem);
			font-weight: 700;
			letter-spacing: -0.015em;
			color: var(--text);
			margin: 0;
		}

		.experience-company {
			color: var(--text-muted);
			font-size: 0.925rem;
			margin-top: 0.25rem;
			display: flex;
			align-items: center;
			gap: 0.4rem;
			flex-wrap: wrap;

			.company-name {
				font-weight: 550;
				color: var(--text);
			}

			.sep {
				color: var(--border);
			}
		}

		.date-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			color: var(--text-muted);
			font-family: var(--font-mono);
			font-size: 0.82rem;
			background: var(--surface-muted);
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			padding: 0.3rem 0.6rem;
			white-space: nowrap;
		}
	}

	.experience-summary {
		color: var(--text-muted);
		line-height: 1.65;
		font-size: 0.975rem;
		margin-top: 1rem;
	}

	.experience-highlights {
		margin-top: 1rem;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;

		li {
			color: var(--text);
			line-height: 1.55;
			font-size: 0.925rem;
			display: flex;
			align-items: flex-start;
			gap: 0.5rem;

			.bullet {
				color: var(--accent);
				font-size: 0.85rem;
				line-height: 1.5;
				flex-shrink: 0;
			}
		}
	}

	.experience-tech {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin-top: 1.25rem;
		padding-top: 0.875rem;
		border-top: 1px solid var(--border);

		.tech-label {
			font-family: var(--font-mono);
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--text-muted);
			text-transform: uppercase;
		}

		.tech-tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.35rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.tech-tag {
			font-family: var(--font-mono);
			font-size: 0.75rem;
			padding: 0.15rem 0.5rem;
			border-radius: var(--radius-sm);
			background: var(--surface-muted);
			color: var(--text-muted);
			border: 1px solid var(--border);
		}
	}

	@media (max-width: 42rem) {
		.timeline-list::before {
			display: none;
		}

		.timeline-marker {
			display: none;
		}

		.timeline-item {
			gap: 0;
		}
	}
</style>

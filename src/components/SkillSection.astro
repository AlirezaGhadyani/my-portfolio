---
import type { SkillCategory, Skill } from '../data/schema.ts';

interface Props {
	categories: SkillCategory[];
}

const { categories } = Astro.props;

const levelLabel = (level: Exclude<Skill['level'], undefined>): string =>
	level.charAt(0).toUpperCase() + level.slice(1);
---

<section id="skills" aria-labelledby="skills-title" class="skills-section">
	<div class="section-header">
		<div class="section-tag">Core Competencies</div>
		<h2 id="skills-title" class="section-title">Technical Skills</h2>
	</div>

	<div class="skills-grid">
		{
			categories.map((category) => (
				<div class="skill-category">
					<div class="category-header">
						<h3 class="skill-category-name">{category.name}</h3>
						<span class="skill-count">{category.skills.length}</span>
					</div>
					<ul class="skill-list">
						{
							category.skills.map((skill) => (
								<li class={skill.highlighted ? 'skill-tag skill-tag--highlight' : 'skill-tag'}>
									<span class="skill-name">{skill.name}</span>
									{skill.level && (
										<span class="skill-level" aria-hidden="true">
											{levelLabel(skill.level)}
										</span>
									)}
								</li>
							))
						}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.skills-section {
		scroll-margin-top: 6rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.section-header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.section-title {
		font-size: clamp(1.6rem, 3.5vw, 2.25rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--text);
		margin: 0;
	}

	.skills-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
	}

	.skill-category {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		padding: 1.5rem;
		box-shadow: var(--shadow-sm);
		transition: var(--transition-fast);

		&:hover {
			border-color: var(--border-active);
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
		}

		.category-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 1rem;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--border-subtle);
		}

		.skill-category-name {
			font-size: 1.05rem;
			font-weight: 700;
			color: var(--text);
			margin: 0;
		}

		.skill-count {
			font-family: var(--font-mono);
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--text-muted);
			background: var(--surface-muted);
			padding: 0.1rem 0.4rem;
			border-radius: 4px;
		}

		.skill-list {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			list-style: none;
			margin: 0;
			padding: 0;

			.skill-tag {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-full);
				padding: 0.35rem 0.75rem;
				background: var(--surface-muted);
				color: var(--text);
				font-size: 0.85rem;
				font-weight: 500;
				transition: var(--transition-fast);

				&:hover {
					border-color: var(--accent);
					background: var(--surface);
					color: var(--accent);
				}

				.skill-level {
					color: var(--text-muted);
					font-family: var(--font-mono);
					font-size: 0.7rem;
				}
			}

			.skill-tag--highlight {
				border-color: var(--accent);
				background: var(--accent-muted);
				color: var(--accent);
				font-weight: 600;

				.skill-level {
					color: var(--accent);
					opacity: 0.8;
				}
			}
		}
	}
</style>

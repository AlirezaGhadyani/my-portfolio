---
import { paletteIds, themeConfig } from "../data/theme.ts";

interface Props {
	id?: string;
}

const { id = "palette-menu" } = Astro.props;

const palettes = paletteIds.map((pid) => themeConfig.palettes[pid]);
---

<div class="palette-selector" data-palette-selector>
	<details class="palette-popup" data-palette-popup id={id}>
		<summary class="palette-trigger" data-palette-trigger>
			<span class="palette-trigger-swatch" aria-hidden="true"></span>
			<span class="palette-trigger-label">Palette</span>
			<svg
				aria-hidden="true"
				viewBox="0 0 24 24"
				width="16"
				height="16"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
			>
		</summary>
		<div class="palette-menu">
			<div class="palette-menu-heading"><strong>Accent palette</strong><span>Choose a mood for the site</span></div>
			<div class="palette-options">
				{
					palettes.map((palette) => (
						<button type="button" class="palette-option" data-palette-option={palette.id} aria-pressed="false">
							<span
								class="palette-swatch"
								style={`--palette-light: ${palette.light.accent}; --palette-dark: ${palette.dark.accent}`}
								aria-hidden="true"
							/>
							<span class="palette-option-copy">
								<>
									<strong>{palette.name}</strong>
									<small>{palette.description}</small>
								</>
							</span>
							{palette.id === themeConfig.defaultPalette && <span class="palette-default">Default</span>}
							<svg
								class="palette-check"
								aria-hidden="true"
								viewBox="0 0 24 24"
								width="17"
								height="17"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round">
								<path d="m5 12 4 4L19 6" />
							</svg>
						</button>
					))
				}
			</div>
			<button type="button" class="palette-reset" data-palette-reset>Reset to default</button>
		</div>
	</details>
</div>

<style>
	.palette-selector {
		position: relative;
	}
	.palette-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.375rem;
		padding: 0.45rem 0.65rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		background: var(--surface);
		color: var(--text-muted);
		cursor: pointer;
		box-shadow: var(--shadow-sm);
		transition: var(--transition-fast);
		list-style: none;
	}
	.palette-trigger::-webkit-details-marker {
		display: none;
	}
	.palette-trigger:hover {
		border-color: var(--accent);
		color: var(--accent);
		background: var(--surface-muted);
	}
	.palette-trigger-label {
		font: 600 0.7rem var(--font-mono);
		letter-spacing: 0.03em;
	}
	.palette-trigger-swatch,
	.palette-swatch {
		display: inline-block;
		width: 1rem;
		height: 1rem;
		border-radius: var(--radius-full);
		background: linear-gradient(
			135deg,
			var(--palette-light, var(--accent)) 50%,
			var(--palette-dark, var(--accent-hover)) 50%
		);
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
	}
	.palette-menu {
		position: absolute;
		z-index: 60;
		top: calc(100% + 0.65rem);
		right: 0;
		width: min(19rem, calc(100vw - 2rem));
		padding: 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface-elevated);
		box-shadow: var(--shadow-lg);
	}
	.palette-menu-heading {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.35rem 0.45rem 0.65rem;
		border-bottom: 1px solid var(--border-subtle);
	}
	.palette-menu-heading strong {
		color: var(--text);
		font-size: 0.85rem;
	}
	.palette-menu-heading span,
	.palette-option small {
		color: var(--text-muted);
		font-size: 0.72rem;
	}
	.palette-options {
		display: grid;
		gap: 0.25rem;
		padding-block: 0.5rem;
	}
	.palette-option {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-height: 3.1rem;
		width: 100%;
		padding: 0.45rem;
		border: 1px solid transparent;
		border-radius: var(--radius-md);
		background: transparent;
		color: var(--text);
		text-align: left;
		cursor: pointer;
	}
	.palette-option:hover,
	.palette-option[aria-pressed="true"] {
		border-color: var(--border-active);
		background: var(--accent-muted);
	}
	.palette-option-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.08rem;
	}
	.palette-option-copy strong {
		font-size: 0.8rem;
	}
	.palette-default {
		padding: 0.18rem 0.35rem;
		border-radius: var(--radius-sm);
		background: var(--accent-muted);
		color: var(--accent);
		font: 600 0.6rem var(--font-mono);
	}
	.palette-check {
		display: none;
		color: var(--accent);
	}
	.palette-option[aria-pressed="true"] .palette-check {
		display: block;
	}
	.palette-reset {
		width: 100%;
		padding: 0.5rem;
		border: 0;
		border-top: 1px solid var(--border-subtle);
		background: transparent;
		color: var(--text-muted);
		font: 600 0.7rem var(--font-mono);
		cursor: pointer;
	}
	.palette-reset:hover {
		color: var(--accent);
	}
	@media (max-width: 48rem) {
		.palette-trigger-label {
			display: none;
		}
	}
</style>

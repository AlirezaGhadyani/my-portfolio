---
import type { Project } from '../data/schema.ts';
import ProjectCard from './ProjectCard.astro';

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;

const orderRank = { flagship: 0, notable: 1, experiment: 2 } as const;

const featured = [...projects]
	.filter((project) => project.featured)
	.sort(
		(a, b) => orderRank[a.tier] - orderRank[b.tier] || a.title.localeCompare(b.title),
	)
	.slice(0, 6);
const flagship = featured.find((project) => project.tier === 'flagship') ?? featured[0];
const supporting = featured.filter((project) => project !== flagship).slice(0, 2);
---

<section id="projects" aria-labelledby="projects-title" class="projects-section">
	<div class="projects-head">
		<div class="head-text section-header" data-section="02">
			<div class="section-tag">Featured Work</div>
			<h2 id="projects-title" class="section-title">Selected Projects</h2>
		</div>
		<a class="projects-archive-link" href="/projects">
			<span>View all projects</span>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="5" y1="12" x2="19" y2="12"></line>
				<polyline points="12 5 19 12 12 19"></polyline>
			</svg>
		</a>
	</div>
	<div class="projects-layout">
		{flagship && <div class="project-feature"><ProjectCard project={flagship} featured /></div>}
		<div class="projects-grid">
			{supporting.map((project) => <ProjectCard project={project} />)}
		</div>
	</div>
</section>

<style>
	.projects-section {
		scroll-margin-top: 6rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.projects-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;

		.head-text {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
		}

		.section-tag {
			font-family: var(--font-mono);
			font-size: 0.8rem;
			font-weight: 600;
			color: var(--accent);
			text-transform: uppercase;
			letter-spacing: 0.08em;
		}

		.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
			font-weight: 750;
			letter-spacing: -0.03em;
			color: var(--text);
			margin: 0;
		}

		.projects-archive-link {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			color: var(--accent);
			font-size: 0.95rem;
			font-weight: 600;
			text-decoration: none;
			padding: 0.4rem 0.75rem;
			border-radius: var(--radius-sm);
			background: var(--surface-muted);
			border: 1px solid var(--border);
			transition: var(--transition-fast);

			svg {
				transition: transform 0.2s ease;
			}

			&:hover {
				background: var(--surface);
				border-color: var(--accent);
				transform: translateY(-1px);

				svg {
					transform: translateX(3px);
				}
			}
		}
	}

	.projects-grid {
		display: grid;
		gap: 1.75rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.projects-layout { display: grid; gap: 1.75rem; }
	.project-feature :global(.project-card) { min-height: 25rem; }

	@media (max-width: 32rem) {
		.projects-grid { grid-template-columns: 1fr; }
	}
</style>

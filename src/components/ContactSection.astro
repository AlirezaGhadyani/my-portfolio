---
import SectionHeader from "./SectionHeader.astro";
import { CONTACT_LIMITS } from "../lib/validation.ts";

interface Props {
	email?: string;
	turnstileSiteKey?: string;
}

const { email = "jordan.avery@example.com", turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "" } =
	Astro.props;
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
	<div class="section-intro">
		<SectionHeader tag="Let's Connect" title="Get in Touch" id="contact-title" />
		<p class="section-subtitle">
			Have an engineering opportunity, consulting inquiry, or technical challenge to discuss? Reach out through the form
			below or email me directly at
			<a href={`mailto:${email}`} class="direct-email">{email}</a>.
		</p>
	</div>

	<div class="contact-card">
		<form id="contact-form" class="contact-form" novalidate>
			<!-- Honeypot Field (hidden from screen readers & humans) -->
			<div class="hp-field" aria-hidden="true">
				<label for="contact-hp">Leave this field blank</label>
				<input type="text" id="contact-hp" name="honeypot" tabindex="-1" autocomplete="off" />
			</div>

			<div class="form-grid">
				<div class="form-group">
					<label for="contact-name">
						Your Name <span class="required" aria-hidden="true">*</span>
					</label>
					<input
						type="text"
						id="contact-name"
						name="name"
						required
						minlength={CONTACT_LIMITS.nameMin}
						maxlength={CONTACT_LIMITS.nameMax}
						autocomplete="name"
						placeholder="Jane Doe"
						class="form-input"
						aria-describedby="name-error"
						aria-invalid="false"
					/>
					<span class="field-error" id="name-error" aria-live="polite"></span>
				</div>

				<div class="form-group">
					<label for="contact-email">
						Email Address <span class="required" aria-hidden="true">*</span>
					</label>
					<input
						type="email"
						id="contact-email"
						name="email"
						required
						maxlength={CONTACT_LIMITS.emailMax}
						autocomplete="email"
						placeholder="jane@example.com"
						class="form-input"
						aria-describedby="email-error"
						aria-invalid="false"
					/>
					<span class="field-error" id="email-error" aria-live="polite"></span>
				</div>
			</div>

			<div class="form-group">
				<label for="contact-message">
					Message <span class="required" aria-hidden="true">*</span>
				</label>
				<textarea
					id="contact-message"
					name="message"
					required
					minlength={CONTACT_LIMITS.messageMin}
					maxlength={CONTACT_LIMITS.messageMax}
					rows="5"
					placeholder="Tell me about your project scope, timeline, or engineering role..."
					class="form-input form-textarea"
					aria-describedby="message-error"
					aria-invalid="false"></textarea>
				<div class="field-meta">
					<span class="field-error" id="message-error" aria-live="polite"></span>
					<span class="char-count" id="message-count">0 / {CONTACT_LIMITS.messageMax}</span>
				</div>
			</div>

			{
				turnstileSiteKey && (
					<div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto" data-size="flexible" />
				)
			}

			<div class="form-actions">
				<button type="submit" id="submit-btn" class="btn-submit">
					<span class="btn-text">
						<span>Send Message</span>
						<svg
							width="15"
							height="15"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true">
							<line x1="22" y1="2" x2="11" y2="13"></line>
							<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
						</svg>
					</span>
					<span class="btn-loading" aria-hidden="true">
						<svg
							class="spinner"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round">
							<line x1="12" y1="2" x2="12" y2="6"></line>
							<line x1="12" y1="18" x2="12" y2="22"></line>
							<line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
							<line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
							<line x1="2" y1="12" x2="6" y2="12"></line>
							<line x1="18" y1="12" x2="22" y2="12"></line>
							<line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
							<line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
						</svg>
						<span>Sending...</span>
					</span>
				</button>
			</div>

			<!-- Status Announcement Banner / Toast -->
			<div id="form-status" class="form-status" role="status" aria-live="polite"></div>
		</form>
	</div>
</section>

{turnstileSiteKey && <div data-turnstile-lazy />}

<script is:inline>
	(function () {
		const form = document.getElementById("contact-form");
		if (!form) return;

		// Lazy-load the Turnstile widget script on first form interaction so its
		// ~50-80 KB of third-party JS is not part of the initial page load.
		const loadTurnstile = () => {
			if (!document.querySelector(".cf-turnstile") || document.querySelector("script[data-turnstile]")) return;
			const script = document.createElement("script");
			script.dataset.turnstile = "";
			script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
			script.async = true;
			script.defer = true;
			document.head.appendChild(script);
		};
		form.addEventListener("focusin", loadTurnstile);
		form.addEventListener("submit", loadTurnstile);

		const nameInput = document.getElementById("contact-name");
		const emailInput = document.getElementById("contact-email");
		const messageInput = document.getElementById("contact-message");
		const messageCount = document.getElementById("message-count");
		const submitBtn = document.getElementById("submit-btn");
		const formStatus = document.getElementById("form-status");
		const nameError = document.getElementById("name-error");
		const emailError = document.getElementById("email-error");
		const messageError = document.getElementById("message-error");

		if (messageInput && messageCount) {
			messageInput.addEventListener("input", () => {
				messageCount.textContent = `${messageInput.value.length} / ${messageInput.maxLength}`;
			});
		}

		function clearErrors() {
			const fields = [nameInput, emailInput, messageInput];
			const errors = [nameError, emailError, messageError];
			fields.forEach((field) => {
				if (field) {
					field.setAttribute("aria-invalid", "false");
				}
			});
			errors.forEach((error) => {
				if (error) error.textContent = "";
			});
			if (formStatus) {
				formStatus.className = "form-status";
				formStatus.textContent = "";
			}
		}

		function showStatus(message, type) {
			if (!formStatus) return;
			formStatus.textContent = message;
			formStatus.className = `form-status status-${type}`;
		}

		function validateClientSide() {
			let isValid = true;
			let firstInvalid = null;
			clearErrors();

			if (!nameInput.value || nameInput.value.trim().length < 2) {
				if (nameError) nameError.textContent = "Please enter at least 2 characters.";
				nameInput.setAttribute("aria-invalid", "true");
				isValid = false;
				firstInvalid = firstInvalid || nameInput;
			}

			const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
			if (!emailInput.value || !emailPattern.test(emailInput.value.trim())) {
				if (emailError) emailError.textContent = "Please enter a valid email address.";
				emailInput.setAttribute("aria-invalid", "true");
				isValid = false;
				firstInvalid = firstInvalid || emailInput;
			}

			if (!messageInput.value || messageInput.value.trim().length < 10) {
				if (messageError) messageError.textContent = "Message must be at least 10 characters long.";
				messageInput.setAttribute("aria-invalid", "true");
				isValid = false;
				firstInvalid = firstInvalid || messageInput;
			}

			if (firstInvalid) firstInvalid.focus();
			return isValid;
		}

		form.addEventListener("submit", async (e) => {
			e.preventDefault();

			if (!validateClientSide()) {
				showStatus("Please fix the errors above before submitting.", "error");
				return;
			}

			const formData = new FormData(form);
			const turnstileToken =
				formData.get("cf-turnstile-response")?.toString() || formData.get("turnstileToken")?.toString();

			const payload = {
				name: formData.get("name")?.toString().trim() || "",
				email: formData.get("email")?.toString().trim() || "",
				message: formData.get("message")?.toString().trim() || "",
				honeypot: formData.get("honeypot")?.toString() || "",
				turnstileToken: turnstileToken || undefined,
			};

			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.classList.add("is-loading");
			}

			try {
				const response = await fetch("/api/contact", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
					},
					body: JSON.stringify(payload),
				});

				const result = await response.json();

				if (response.ok && result.success) {
					showStatus(result.message || "Message sent successfully! I will get back to you soon.", "success");
					form.reset();
					if (messageCount) messageCount.textContent = `0 / ${messageInput.maxLength}`;
					if (window.turnstile) {
						window.turnstile.reset();
					}
				} else {
					showStatus(result.error || "An error occurred while sending your message. Please try again.", "error");
				}
			} catch {
				showStatus("Network error. Please check your connection or reach out via direct email.", "error");
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.classList.remove("is-loading");
				}
			}
		});
	})();
</script>

<style>
	.contact-section {
		scroll-margin-top: 6rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-bottom: 2rem;
	}

	.section-intro {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.section-subtitle {
		color: var(--text-muted);
		font-size: 1.05rem;
		max-width: 65ch;
		line-height: 1.6;
		margin: 0;
	}

	.direct-email {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
		font-weight: 550;

		&:hover {
			opacity: 0.85;
		}
	}

	.contact-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: clamp(2rem, 5vw, 4rem);
		box-shadow: var(--shadow-lg);
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.hp-field {
		display: none !important;
		visibility: hidden;
		position: absolute;
		left: -9999px;
	}

	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	@media (max-width: 42rem) {
		.form-grid {
			grid-template-columns: 1fr;
		}
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	label {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text);
	}

	.required {
		color: var(--danger);
	}

	.form-input {
		width: 100%;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text);
		font-family: inherit;
		font-size: 1rem;
		padding-block: 0.9rem;
		transition: var(--transition-fast);

		&:focus {
			outline: none;
			border-color: var(--accent);
			box-shadow: 0 0 0 3px var(--accent-muted);
		}

		&::placeholder {
			color: var(--text-subtle);
		}
	}

	.form-textarea {
		resize: vertical;
		min-height: 130px;
	}

	.field-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.8rem;
	}

	.field-error {
		color: var(--danger);
		font-size: 0.82rem;
		min-height: 1.2em;
		font-weight: 500;
	}

	.char-count {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.form-actions {
		display: flex;
		justify-content: flex-start;
		margin-top: 0.5rem;
	}

	.btn-submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 2.25rem;
		border-radius: var(--radius-sm);
		background: var(--accent);
		color: var(--on-accent);
		border: 1px solid var(--accent);
		font-size: 0.975rem;
		font-weight: 600;
		cursor: pointer;
		box-shadow: 0 4px 14px var(--accent-glow);
		transition: var(--transition-fast);

		&:hover {
			background: var(--accent-hover);
			border-color: var(--accent-hover);
			transform: translateY(-2px);
			box-shadow: 0 6px 18px var(--accent-glow);
		}

		&:active {
			transform: scale(0.98);
		}

		&:disabled {
			opacity: 0.6;
			cursor: not-allowed;
			transform: none;
		}

		.btn-text {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
		}

		.btn-loading {
			display: none;
			align-items: center;
			gap: 0.5rem;
		}

		&.is-loading {
			.btn-text {
				display: none;
			}
			.btn-loading {
				display: inline-flex;
			}
		}
	}

	@keyframes spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.spinner {
		animation: spin 1s linear infinite;
	}

	.form-status {
		padding: 0.875rem 1.25rem;
		border-radius: var(--radius-sm);
		font-size: 0.92rem;
		line-height: 1.4;
		font-weight: 500;

		&.status-success {
			background: color-mix(in srgb, var(--status-success) 12%, transparent);
			border: 1px solid color-mix(in srgb, var(--status-success) 35%, transparent);
			color: var(--status-success);
		}

		&.status-error {
			background: color-mix(in srgb, var(--danger) 12%, transparent);
			border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent);
			color: var(--danger);
		}
	}
</style>

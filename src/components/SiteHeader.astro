---
import ThemeToggle from "./ThemeToggle.astro";
import PaletteSelector from "./PaletteSelector.astro";
import { resumeData } from "../data/resume.ts";

const { identity } = resumeData;
const initials = identity.name
	.split(" ")
	.map((part) => part[0])
	.join("")
	.slice(0, 2);

const nav = [
	{ href: "/#experience", label: "Experience" },
	{ href: "/#projects", label: "Projects" },
	{ href: "/#skills", label: "Skills" },
	{ href: "/#education", label: "Education" },
	{ href: "/print/resume", label: "Resume", badge: "PDF" },
	{ href: "/#contact", label: "Contact" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string): "page" | undefined =>
	href.includes("#") ? undefined : href.split("#")[0].replace(/\/$/, "") === pathname ? "page" : undefined;
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/">
			<div class="brand-avatar">{initials}</div>
			<div class="brand-text">
				<span class="brand-name">{identity.name}</span>
				<span class="brand-role">{identity.title}</span>
			</div>
		</a>

		<nav class="nav-desktop" aria-label="Primary">
			<ul>
				{
					nav.map(({ href, label, badge }) => (
						<li>
							<a href={href} class="nav-link" aria-current={isCurrent(href)}>
								{label}
								{badge && <span class="nav-badge">{badge}</span>}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="header-actions">
			<PaletteSelector id="palette-menu-desktop" />
			<ThemeToggle />
			<button
				type="button"
				class="nav-toggle"
				data-nav-toggle
				aria-controls="nav-mobile"
				aria-expanded="false"
				aria-label="Open primary navigation">
				<span class="nav-toggle-icon" aria-hidden="true">
					<span class="bar bar-top"></span>
					<span class="bar bar-middle"></span>
					<span class="bar bar-bottom"></span>
				</span>
			</button>
		</div>
	</div>

	<nav id="nav-mobile" class="nav-mobile" aria-label="Mobile Navigation" hidden>
		<div class="nav-mobile-inner">
			<div class="mobile-settings">
				<div class="mobile-settings-heading">Theme &amp; Accent</div>
				<div class="mobile-settings-controls">
					<PaletteSelector id="palette-menu-mobile" />
					<ThemeToggle />
				</div>
			</div>
			<ul>
				{
					nav.map(({ href, label, badge }) => (
						<li>
							<a href={href} class="mobile-nav-link" aria-current={isCurrent(href)}>
								<span>{label}</span>
								{badge && <span class="nav-badge">{badge}</span>}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</nav>
</header>

<script is:inline>
	(function () {
		document.addEventListener("DOMContentLoaded", () => {
			const toggleButton = document.querySelector("[data-nav-toggle]");
			const mobileNav = document.getElementById("nav-mobile");
			if (toggleButton && mobileNav) {
				const backgroundEls = () =>
					[...document.querySelectorAll("main, footer")].filter((el) => el instanceof HTMLElement && el !== mobileNav);
				const showBackground = (inert) => {
					backgroundEls().forEach((el) => {
						el.inert = inert;
					});
				};

				const close = () => {
					mobileNav.hidden = true;
					toggleButton.setAttribute("aria-expanded", "false");
					toggleButton.setAttribute("aria-label", "Open primary navigation");
					document.body.classList.remove("menu-open");
					showBackground(false);
				};

				const open = () => {
					mobileNav.hidden = false;
					toggleButton.setAttribute("aria-expanded", "true");
					toggleButton.setAttribute("aria-label", "Close primary navigation");
					document.body.classList.add("menu-open");
					toggleButton.setAttribute("aria-controls", "nav-mobile");
					showBackground(true);
					const firstLink = mobileNav.querySelector("a");
					if (firstLink) firstLink.focus();
				};

				toggleButton.addEventListener("click", () => {
					const isHidden = mobileNav.hidden;
					if (isHidden) {
						open();
					} else {
						close();
					}
				});

				// Close on link click inside mobile drawer
				mobileNav.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", () => {
						close();
					});
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && !mobileNav.hidden) {
						close();
						toggleButton.focus();
					}
				});

				const desktopQuery = window.matchMedia("(min-width: 48rem)");
				const onBreakpointChange = () => {
					if (desktopQuery.matches && !mobileNav.hidden) close();
				};
				desktopQuery.addEventListener("change", onBreakpointChange);
			}
		});
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border-subtle);
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: var(--content-width);
		margin-inline: auto;
		padding: 0.8rem clamp(1.25rem, 5vw, 3.5rem);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: var(--text);
		outline-offset: 4px;

		.brand-avatar {
			width: 2.25rem;
			height: 2.25rem;
			border-radius: var(--radius-sm);
			background: transparent;
			border: 1px solid var(--accent);
			color: var(--text);
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: 700;
			font-size: 0.85rem;
			letter-spacing: 0.02em;
			box-shadow: 3px 3px 0 var(--accent-glow);
			transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
		}

		&:hover .brand-avatar {
			transform: scale(1.08) rotate(-4deg);
		}

		.brand-text {
			display: flex;
			flex-direction: column;
			line-height: 1.2;
		}

		.brand-name {
			font-weight: 700;
			font-size: 1.05rem;
			letter-spacing: -0.015em;
		}

		.brand-role {
			color: var(--text-muted);
			font-size: 0.8rem;
			font-weight: 450;
		}
	}

	.nav-desktop ul {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		border-radius: var(--radius-sm);
		padding: 0.5rem 0.875rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.925rem;
		font-weight: 500;
		transition: var(--transition-fast);

		&:hover {
			color: var(--text);
			background: var(--surface-muted);
		}
	}

	.nav-badge {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		padding: 0.125rem 0.375rem;
		border-radius: var(--radius-sm);
		background: var(--accent-muted);
		color: var(--text);
		line-height: 1;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.375rem;
		height: 2.375rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		cursor: pointer;
		padding: 0;
		box-shadow: var(--shadow-sm);
		transition: var(--transition-fast);

		&:hover {
			border-color: var(--accent);
			background: var(--surface-muted);
		}

		.nav-toggle-icon {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 4px;
			width: 18px;
			height: 18px;
		}

		.bar {
			width: 16px;
			height: 2px;
			background-color: var(--text);
			border-radius: var(--radius-sm);
			transition:
				transform 0.2s ease,
				opacity 0.2s ease;
		}

		&[aria-expanded="true"] {
			.bar-top {
				transform: translateY(6px) rotate(45deg);
			}
			.bar-middle {
				opacity: 0;
			}
			.bar-bottom {
				transform: translateY(-6px) rotate(-45deg);
			}
		}
	}

	.nav-mobile {
		background: color-mix(in srgb, var(--surface) 96%, var(--bg));
		border-bottom: 1px solid var(--border);
		box-shadow: var(--shadow-md);
		animation: fade-in-up 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;

		.nav-mobile-inner {
			padding: 1rem clamp(1.25rem, 5vw, 3rem) 1.5rem;
			max-width: var(--content-width);
			margin-inline: auto;
		}

		.mobile-settings {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			margin-bottom: 0.75rem;
			padding: 0.25rem 0.45rem 0.75rem;
			border-bottom: 1px solid var(--border-subtle);
		}

		.mobile-settings-heading {
			color: var(--text-muted);
			font: 600 0.7rem var(--font-mono);
			letter-spacing: 0.04em;
			text-transform: uppercase;
		}

		.mobile-settings-controls {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		ul {
			display: flex;
			flex-direction: column;
			gap: 0.375rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.mobile-nav-link {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.75rem 1rem;
			border-radius: var(--radius-md);
			color: var(--text);
			text-decoration: none;
			font-size: 0.78rem;
			font-weight: 500;
			font-family: var(--font-mono);
			letter-spacing: 0.02em;
			min-height: 44px;
			transition: var(--transition-fast);

			&:hover {
				color: var(--accent);
				background: var(--surface-muted);
			}
		}
	}

	@media (max-width: 48rem) {
		.nav-desktop {
			display: none;
		}

		.nav-toggle {
			display: inline-flex;
		}
	}
</style>

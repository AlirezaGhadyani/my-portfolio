---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
	{ href: '#experience', label: 'Experience' },
	{ href: '#projects', label: 'Projects' },
	{ href: '#skills', label: 'Skills' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/">
			<span class="brand-name">Jordan Avery</span>
			<span class="brand-role">Full-Stack Engineer</span>
		</a>

		<nav class="nav-desktop" aria-label="Primary">
			<ul>
				{
					nav.map(({ href, label }) => (
						<li>
							<a href={href}>{label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="header-actions">
			<ThemeToggle />
			<button
				type="button"
				class="nav-toggle"
				data-nav-toggle
				aria-controls="nav-mobile"
				aria-expanded="false"
				aria-label="Open primary navigation"
			>
				<span class="nav-toggle-icon" aria-hidden="true"></span>
			</button>
		</div>
	</div>

	<nav id="nav-mobile" class="nav-mobile" aria-label="Mobile" hidden>
		<ul>
			{
				nav.map(({ href, label }) => (
					<li>
						<a href={href}>{label}</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script is:inline>
	const toggleButton = document.querySelector('[data-nav-toggle]');
	const mobileNav = document.getElementById('nav-mobile');
	if (toggleButton && mobileNav) {
		const close = () => {
			mobileNav.hidden = true;
			toggleButton.setAttribute('aria-expanded', 'false');
			toggleButton.setAttribute('aria-label', 'Open primary navigation');
		};
		toggleButton.addEventListener('click', () => {
			const willOpen = mobileNav.hidden;
			mobileNav.hidden = !willOpen;
			toggleButton.setAttribute('aria-expanded', String(willOpen));
			toggleButton.setAttribute(
				'aria-label',
				willOpen ? 'Close primary navigation' : 'Open primary navigation',
			);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !mobileNav.hidden) close();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 88%, var(--surface));
		backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 76rem;
		margin-inline: auto;
		padding: 0.875rem clamp(1.25rem, 5vw, 3rem);
	}

	.brand {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
		text-decoration: none;
		color: var(--text);

		.brand-name {
			font-weight: 650;
			font-size: 1.05rem;
		}

		.brand-role {
			color: var(--text-muted);
			font-size: 0.8rem;
		}
	}

	.nav-desktop ul {
		display: flex;
		gap: 0.5rem;
		list-style: none;
	}

	.nav-desktop a {
		border-radius: 8px;
		padding: 0.5rem 0.875rem;
		color: var(--text-muted);
		text-decoration: none;

		&:hover {
			color: var(--accent);
			background: var(--accent-muted);
		}
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.nav-toggle {
		display: none;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--surface);
		cursor: pointer;
		position: relative;
	}

	.nav-toggle-icon {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 16px;
		height: 2px;
		border-radius: 2px;
		background: var(--text);
		box-shadow: 0 -5px 0 var(--text), 0 5px 0 var(--text);
	}

	.nav-mobile {
		position: sticky;
		background: var(--surface);
		border-bottom: 1px solid var(--border);
		padding: 0.5rem clamp(1.25rem, 5vw, 3rem);

		ul {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			list-style: none;
		}

		a {
			display: block;
			padding: 0.625rem 0.75rem;
			border-radius: 8px;
			color: var(--text-muted);
			text-decoration: none;

			&:hover {
				color: var(--accent);
				background: var(--accent-muted);
			}
		}
	}

	@media (max-width: 48rem) {
		.nav-desktop {
			display: none;
		}

		.nav-toggle {
			display: inline-flex;
		}
	}
</style>
---
import type { Project } from '../data/schema.ts';

interface Props {
	project: Project;
}

const { project } = Astro.props;

const tierLabel = { flagship: 'Flagship', notable: 'Notable', experiment: 'Experiment' }[
	project.tier
];

const primaryUrl = project.hasCaseStudy
	? `/projects/${project.slug}`
	: (project.liveUrl ?? project.githubUrl);
const externalTarget = project.hasCaseStudy ? undefined : '_blank';
const externalRel = project.hasCaseStudy ? undefined : 'noreferrer noopener';
---

<article class="project-card">
	<div class="project-card-head">
		<div>
			<h3 class="project-card-title">
				{primaryUrl ? (
					<a
						href={primaryUrl}
						target={externalTarget}
						rel={externalRel}
						class="project-card-link"
					>
						{project.title}
					</a>
				) : (
					project.title
				)}
			</h3>
			<p class="project-card-subtitle">{project.subtitle}</p>
		</div>
		<span class="project-card-tier" aria-hidden="true">{tierLabel}</span>
	</div>

	<p class="project-card-role">{project.role}</p>
	<p class="project-card-description">{project.description}</p>

	{project.impactMetrics && project.impactMetrics.length > 0 && (
		<ul class="project-card-metrics">
			{project.impactMetrics.map((metric) => <li>{metric}</li>)}
		</ul>
	)}

	<div class="project-card-foot">
		<ul class="project-tech" aria-label="Technologies">
			{project.technologies.map((tech) => <li>{tech}</li>)}
		</ul>
		<ul class="project-actions" aria-label={`${project.title} links`}>
			{project.hasCaseStudy && (
				<li>
					<a href={`/projects/${project.slug}`}>Case study</a>
				</li>
			)}
			{project.liveUrl && (
				<li>
					<a href={project.liveUrl} target="_blank" rel="noreferrer noopener">
						Live
					</a>
				</li>
			)}
			{project.githubUrl && (
				<li>
					<a href={project.githubUrl} target="_blank" rel="noreferrer noopener">
						Code
					</a>
				</li>
			)}
		</ul>
	</div>
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		padding: 1.5rem;
		box-shadow: 0 1px 2px var(--shadow-color);
	}

	.project-card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;

		.project-card-title {
			font-size: 1.25rem;
			font-weight: 680;
			letter-spacing: -0.02em;
			color: var(--text);

			.project-card-link {
				color: inherit;
				text-decoration: none;

				&:hover {
					color: var(--accent);
				}
			}
		}

		.project-card-subtitle {
			color: var(--text-muted);
			font-size: 0.95rem;
			margin-top: 0.375rem;
		}

		.project-card-tier {
			flex-shrink: 0;
			border: 1px solid var(--border);
			border-radius: 999px;
			padding: 0.25rem 0.625rem;
			background: var(--surface-muted);
			color: var(--text-muted);
			font-family: var(--font-mono);
			font-size: 0.75rem;
		}
	}

	.project-card-role {
		color: var(--accent);
		font-size: 0.9rem;
		margin-top: 1rem;
	}

	.project-card-description {
		color: var(--text);
		line-height: 1.7;
		margin-top: 0.5rem;
	}

	.project-card-metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
		list-style: none;

		li {
			border: 1px solid var(--border);
			border-radius: 999px;
			padding: 0.25rem 0.625rem;
			background: var(--accent-muted);
			color: var(--accent);
			font-family: var(--font-mono);
			font-size: 0.78rem;
		}
	}

	.project-card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 1.25rem;

		.project-tech {
			display: flex;
			flex-wrap: wrap;
			gap: 0.375rem;
			list-style: none;

			li {
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.25rem 0.625rem;
				background: var(--surface-muted);
				color: var(--text);
				font-size: 0.8rem;
			}
		}

		.project-actions {
			display: flex;
			gap: 0.5rem;
			list-style: none;

			li a {
				border-radius: 8px;
				padding: 0.5rem 0.85rem;
				background: var(--surface-muted);
				color: var(--text);
				text-decoration: none;

				&:hover {
					color: var(--accent);
					background: var(--accent-muted);
				}
			}
		}
	}
</style>
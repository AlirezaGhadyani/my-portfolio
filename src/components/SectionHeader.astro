---
interface Props {
	tag: string;
	title: string;
	id: string;
}

const { tag, title, id } = Astro.props;
---

<div class="section-header">
	<div class="section-tag">{tag}</div>
	<h2 id={id} class="section-title">{title}</h2>
</div>

<style>
	.section-header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.section-tag {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 750;
		letter-spacing: -0.03em;
		color: var(--text);
		margin: 0;
	}
</style>

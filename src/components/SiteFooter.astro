---
import { resumeData } from '../data/resume.ts';

const { identity } = resumeData;
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-brand">
			<span class="brand-name">{identity.name}</span>
			<span class="brand-tagline">{identity.tagline}</span>
		</div>

		<nav class="footer-nav" aria-label="Social profiles">
			<ul class="footer-links">
				{
					identity.links.map(({ label, url }) => (
						<li>
							<a href={url} target="_blank" rel="noreferrer noopener" class="footer-link">
								<span>{label}</span>
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="7" y1="17" x2="17" y2="7"></line>
									<polyline points="7 7 17 7 17 17"></polyline>
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="footer-bottom">
			<p class="footer-meta">© {new Date().getFullYear()} {identity.name} · Designed & Built with Astro</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		border-top: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 95%, var(--surface));
		padding-block: 4rem 2rem;
	}

	.footer-inner {
		max-width: 82rem;
		margin-inline: auto;
		padding-inline: clamp(1.25rem, 5vw, 3rem);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: center;
		text-align: center;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;

		.brand-name {
			font-weight: 700;
			font-size: 1.1rem;
			color: var(--text);
			letter-spacing: -0.015em;
		}

		.brand-tagline {
			font-size: 0.875rem;
			color: var(--text-muted);
		}
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: var(--transition-fast);

		svg {
			color: var(--text-subtle);
			transition: transform 0.2s ease, color 0.2s ease;
		}

		&:hover {
			color: var(--accent);

			svg {
				color: var(--accent);
				transform: translate(1px, -1px);
			}
		}
	}

	.footer-bottom {
		padding-top: 1.25rem;
		border-top: 1px solid var(--border-subtle);
		width: 100%;
	}

	.footer-meta {
		color: var(--text-subtle);
		font-size: 0.8125rem;
		margin: 0;
	}
</style>

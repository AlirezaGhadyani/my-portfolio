---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { resumeData } from '../../data/resume.ts';

const { projects } = resumeData;

const techs = [...new Set(projects.flatMap((project) => project.technologies))].sort();
const slug = (value: string): string =>
	value
		.toLowerCase()
		.replace(/&/g, 'and')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
---

<Layout title="Projects & Engineering Work — Jordan Avery" description="An archive of shipped applications, open-source tools, and system architecture case studies.">
	<section class="projects-hero" aria-labelledby="projects-title">
		<a href="/" class="back-link">
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="19" y1="12" x2="5" y2="12"></line>
				<polyline points="12 19 5 12 12 5"></polyline>
			</svg>
			<span>Back to Overview</span>
		</a>
		<h1 id="projects-title" class="projects-title">Project Archive</h1>
		<p class="projects-intro">
			A curated collection of web applications, cloud infrastructure, developer tools, and case studies. Filter by technology stack below.
		</p>
	</section>

	<div class="projects-filter" aria-label="Filter projects by technology">
		<span class="projects-filter-label" aria-hidden="true">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
			</svg>
			<span>Filter by Stack:</span>
		</span>
		<div class="projects-chips" role="group" aria-label="Technology filters">
			<button type="button" class="projects-chip projects-chip--active" data-filter="all">
				All ({projects.length})
			</button>
			{techs.map((tech) => (
				<button
					type="button"
					class="projects-chip"
					data-filter={slug(tech)}
					aria-pressed="false"
				>
					{tech}
				</button>
			))}
		</div>
	</div>

	<ul class="projects-list" data-projects-list id="projects-list">
		{
			projects.map((project) => (
				<li
					class="project-entry"
					data-tech={project.technologies.map(slug).join(' ')}
				>
					<ProjectCard project={project} />
				</li>
			))
		}
	</ul>
</Layout>

<script is:inline>
	(function () {
		const chips = Array.from(document.querySelectorAll('.projects-chip'));
		const entries = Array.from(document.querySelectorAll('.project-entry'));
		const list = document.getElementById('projects-list');

		if (list && chips.length && entries.length) {
			let active = 'all';
			const apply = () => {
				entries.forEach((entry) => {
					const tags = (entry.dataset.tech ?? '').split(' ');
					entry.hidden = !(active === 'all' || tags.includes(active));
				});
			};
			chips.forEach((chip) => {
				chip.addEventListener('click', () => {
					active = chip.dataset.filter ?? 'all';
					chips.forEach((other) => {
						const selected = other === chip;
						other.setAttribute('aria-pressed', String(selected));
						other.classList.toggle('projects-chip--active', selected);
					});
					apply();
				});
			});
			apply();
		}
	})();
</script>

<style>
	.projects-hero {
		padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		margin-bottom: 0.5rem;
		transition: var(--transition-fast);

		svg {
			transition: transform 0.2s ease;
		}

		&:hover {
			color: var(--accent);

			svg {
				transform: translateX(-3px);
			}
		}
	}

	.projects-title {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		line-height: 1.1;
		letter-spacing: -0.035em;
		font-weight: 800;
		color: var(--text);
		margin: 0;
	}

	.projects-intro {
		color: var(--text-muted);
		font-size: 1.1rem;
		line-height: 1.65;
		max-width: 65ch;
		margin: 0;
	}

	.projects-filter {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 2.5rem;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-sm);

		.projects-filter-label {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			color: var(--text-muted);
			font-size: 0.85rem;
			font-weight: 600;
			text-transform: uppercase;
			font-family: var(--font-mono);
			letter-spacing: 0.04em;
		}

		.projects-chips {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;

			.projects-chip {
				border: 1px solid var(--border);
				border-radius: var(--radius-full);
				padding: 0.35rem 0.85rem;
				background: var(--surface-muted);
				color: var(--text-muted);
				font-size: 0.825rem;
				font-weight: 500;
				cursor: pointer;
				transition: var(--transition-fast);

				&:hover {
					border-color: var(--accent);
					color: var(--accent);
					background: var(--surface);
				}
			}

			.projects-chip--active {
				border-color: var(--accent);
				background: var(--accent);
				color: #ffffff !important;
				font-weight: 600;
			}
		}
	}

	.projects-list {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr));
		list-style: none;
		margin: 0 0 5rem 0;
		padding: 0;
	}

	.project-entry {
		display: flex;

		& > :global(article) {
			width: 100%;
		}
	}

	@media (max-width: 32rem) {
		.projects-list {
			grid-template-columns: 1fr;
		}
	}
</style>

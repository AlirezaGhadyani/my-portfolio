---
import { getEntry, render, getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { resumeData } from "../../data/resume.ts";

export async function getStaticPaths() {
	const caseStudies = await getCollection("caseStudies");
	return caseStudies.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("caseStudies", slug);
if (!entry) throw new Error(`Case study not found: ${slug}`);

const { Content } = await render(entry);
const { data } = entry;
const project = resumeData.projects.find((item) => item.slug === data.projectSlug);
if (!project) throw new Error(`Project not found for case study: ${data.projectSlug}`);
---

<Layout title={`${data.title} — Technical Case Study`} description={data.summary}>
	<article class="case-study">
		<a class="case-back" href="/projects">
			<svg
				width="15"
				height="15"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true">
				<line x1="19" y1="12" x2="5" y2="12"></line>
				<polyline points="12 19 5 12 12 5"></polyline>
			</svg>
			<span>Back to Projects Archive</span>
		</a>

		<header class="case-header">
			<div class="case-eyebrow">Technical Deep Dive</div>
			<h1 class="case-title">{data.title}</h1>
			<p class="case-summary">{data.summary}</p>

			<div class="case-meta-grid">
				<div class="meta-card">
					<span class="meta-label">Role</span>
					<span class="meta-value">{project.role}</span>
				</div>
				<div class="meta-card">
					<span class="meta-label">Timeline / Duration</span>
					<span class="meta-value">{data.duration}</span>
				</div>
				<div class="meta-card full-width">
					<span class="meta-label">Core Architecture & Stack</span>
					<span class="meta-value">{project.technologies.join(", ")}</span>
				</div>
			</div>
		</header>

		{
			project.impactMetrics && project.impactMetrics.length > 0 && (
				<div class="metrics-container">
					<h2 class="metrics-title">Key Architectural Outcomes & Metrics</h2>
					<ul class="case-metrics">
						{project.impactMetrics.map((metric) => (
							<li>
								<svg
									width="14"
									height="14"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true">
									<polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
									<polyline points="17 6 23 6 23 12" />
								</svg>
								<span>{metric}</span>
							</li>
						))}
					</ul>
				</div>
			)
		}

		<div class="case-body">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.case-study {
		padding-block: clamp(2.5rem, 5vw, 4rem) 5rem;
		max-width: 66rem;
		margin-inline: auto;
	}

	.case-back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		margin-bottom: 2rem;
		transition: var(--transition-fast);

		svg {
			transition: transform 0.2s ease;
		}

		&:hover {
			color: var(--accent);

			svg {
				transform: translateX(-3px);
			}
		}
	}

	.case-header {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 2.5rem;
		border-bottom: 1px solid var(--border-subtle);
		padding-bottom: 3rem;

		.case-eyebrow {
			font-family: var(--font-mono);
			font-size: 0.8rem;
			font-weight: 600;
			color: var(--accent);
			text-transform: uppercase;
			letter-spacing: 0.08em;
		}

		.case-title {
			font-size: clamp(2.75rem, 6vw, 5rem);
			line-height: 1.08;
			letter-spacing: -0.035em;
			font-weight: 800;
			color: var(--text);
			margin: 0;
		}

		.case-summary {
			color: var(--text-muted);
			font-size: 1.15rem;
			line-height: 1.65;
			margin: 0;
		}
	}

	.case-meta-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.875rem;
		margin-top: 1rem;

		.meta-card {
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			padding: 0.875rem 1.125rem;
			display: flex;
			flex-direction: column;
			gap: 0.25rem;

			&.full-width {
				grid-column: 1 / -1;
			}

			.meta-label {
				font-family: var(--font-mono);
				font-size: 0.725rem;
				font-weight: 600;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}

			.meta-value {
				color: var(--text);
				font-size: 0.95rem;
				font-weight: 600;
			}
		}
	}

	.metrics-container {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem;
		margin-bottom: 3rem;
		box-shadow: var(--shadow-sm);

		.metrics-title {
			font-size: 0.95rem;
			font-weight: 700;
			color: var(--text);
			text-transform: uppercase;
			letter-spacing: 0.04em;
			font-family: var(--font-mono);
			margin: 0 0 1rem 0;
		}
	}

	.case-metrics {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		list-style: none;
		margin: 0;
		padding: 0;

		li {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			color: var(--text);
			font-size: 0.95rem;
			font-weight: 500;
			line-height: 1.4;

			svg {
				color: var(--status-live);
				flex-shrink: 0;
			}
		}
	}

	.case-body {
		line-height: 1.75;
		color: var(--text);

		:global(h2) {
			font-size: 1.6rem;
			font-weight: 750;
			letter-spacing: -0.025em;
			color: var(--text);
			margin-top: 2.75rem;
			margin-bottom: 0.75rem;
			padding-bottom: 0.35rem;
			border-bottom: 1px solid var(--border-subtle);
		}

		:global(h3) {
			font-size: 1.2rem;
			font-weight: 700;
			letter-spacing: -0.015em;
			color: var(--text);
			margin-top: 1.75rem;
			margin-bottom: 0.5rem;
		}

		:global(p) {
			color: var(--text-muted);
			font-size: 1.025rem;
			margin-block: 1.15rem;
		}

		:global(ul),
		:global(ol) {
			padding-inline-start: 1.5rem;
			margin-block: 1.15rem;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}

		:global(li) {
			color: var(--text-muted);
			font-size: 1rem;
		}

		:global(li::marker) {
			color: var(--accent);
		}

		:global(a) {
			color: var(--accent);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover {
				opacity: 0.85;
			}
		}

		:global(code) {
			background: var(--surface-muted);
			border: 1px solid var(--border);
			border-radius: 4px;
			padding: 0.15rem 0.4rem;
			font-family: var(--font-mono);
			font-size: 0.875rem;
			color: var(--text);
		}

		:global(pre) {
			background: var(--surface-muted) !important;
			border: 1px solid var(--border);
			border-radius: var(--radius);
			padding: 1.25rem;
			overflow-x: auto;
			margin-block: 1.5rem;

			:global(code) {
				background: transparent !important;
				border: none;
				padding: 0;
			}
		}
	}

	@media (max-width: 36rem) {
		.case-meta-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import { getEntry, render, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { resumeData } from '../../data/resume.ts';

export async function getStaticPaths() {
	const caseStudies = await getCollection('caseStudies');
	return caseStudies.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry('caseStudies', slug);
if (!entry) return Astro.throw(404, 'Case study not found');

const { Content } = await render(entry);
const { data } = entry;
const project = resumeData.projects.find((item) => item.slug === data.projectSlug);
---

<Layout title={`${data.title} — Case Study`} description={data.summary}>
	<article class="case-study">
		<a class="case-back" href="/projects">← All projects</a>

		<header class="case-header">
			<h1 class="case-title">{data.title}</h1>
			<p class="case-summary">{data.summary}</p>
			<dl class="case-meta">
				{project?.role && (
					<div>
						<dt>Role</dt>
						<dd>{data.role}</dd>
					</div>
				)}
				<div>
					<dt>Duration</dt>
					<dd>{data.duration}</dd>
				</div>
				<div>
					<dt>Stack</dt>
					<dd>{data.techStack.join(', ')}</dd>
				</div>
			</dl>
			{project?.role && <p class="case-role">{project.role}</p>}
		</header>

		{data.impactMetrics.length > 0 && (
			<ul class="case-metrics">
				{data.impactMetrics.map((metric) => <li>{metric}</li>)}
			</ul>
		)}

		<div class="case-body">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.case-study {
		padding-block: 3rem 4rem;
	}

	.case-back {
		display: inline-block;
		color: var(--text-muted);
		text-decoration: none;
		margin-bottom: 2rem;

		&:hover {
			color: var(--accent);
		}
	}

	.case-header {
		margin-bottom: 2rem;

		.case-title {
			font-size: clamp(2rem, 5vw, 3.25rem);
			line-height: 1.1;
			letter-spacing: -0.03em;
			font-weight: 680;
			color: var(--text);
		}

		.case-summary {
			color: var(--text-muted);
			font-size: 1.05rem;
			line-height: 1.7;
			max-width: 65ch;
			margin-top: 1rem;
		}

		.case-meta {
			display: grid;
			gap: 0.625rem;
			margin-top: 1.5rem;

			div {
				display: flex;
				gap: 0.5rem;

				dt {
					color: var(--text-muted);
					font-weight: 600;
					min-width: 6rem;
				}

				dd {
					color: var(--text);
				}
			}
		}

		.case-role {
			color: var(--accent);
			font-size: 0.9rem;
			margin-top: 1rem;
		}
	}

	.case-metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin-bottom: 2.5rem;

		li {
			border: 1px solid var(--border);
			border-radius: 999px;
			padding: 0.375rem 0.875rem;
			background: var(--accent-muted);
			color: var(--accent);
			font-family: var(--font-mono);
			font-size: 0.85rem;
		}
	}

	.case-body {
		max-width: 70ch;
		line-height: 1.75;

		h2 {
			font-size: 1.5rem;
			font-weight: 680;
			letter-spacing: -0.02em;
			color: var(--text);
			margin-top: 2rem;
		}

		h3 {
			font-size: 1.125rem;
			font-weight: 640;
			color: var(--text);
			margin-top: 1.5rem;
		}

		p {
			color: var(--text);
			margin-block: 1rem;
		}

		ul,
		ol {
			padding-inline-start: 1.5rem;
			color: var(--text);
			margin-block: 1rem;
		}

		li::marker {
			color: var(--accent);
		}

		a {
			color: var(--accent);
			text-decoration: underline;
		}

		code {
			background: var(--surface-muted);
			border-radius: 6px;
			padding: 0.125rem 0.375rem;
			font-family: var(--font-mono);
			font-size: 0.875rem;
		}
	}
</style>
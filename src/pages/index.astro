---
import Layout from '../layouts/Layout.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SkillSection from '../components/SkillSection.astro';
import EducationSection from '../components/EducationSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import { resumeData } from '../data/resume.ts';

const { identity, summary, experience, skills, education, certifications, projects } =
	resumeData;
---

<Layout>
	<section class="hero" aria-labelledby="hero-title">
		<p class="hero-eyebrow">{identity.tagline}</p>
		<h1 id="hero-title" class="hero-title">{identity.name}</h1>
		<p class="hero-role">
			<span class="role-dot" aria-hidden="true"></span>
			{identity.title}
		</p>
		<p class="hero-summary">{summary.full}</p>
		<nav class="hero-links" aria-label="Quick links">
			{
				identity.links.map(({ label, url }) => (
					<a href={url} target="_blank" rel="noreferrer noopener">
						{label}
					</a>
				))
			}
			<a href="/print/resume" class="btn-resume">
				<span>View & Download Resume</span>
				<span class="badge-formats">PDF / TXT</span>
			</a>
		</nav>
	</section>

	<div class="main-sections">
		<ExperienceSection items={experience} />
		<ProjectsSection projects={projects} />
		<SkillSection categories={skills} />
		<EducationSection education={education} certifications={certifications} />
	</div>
</Layout>

<style>
	.main-sections {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
		padding-block: 6rem 4rem;
	}

	.hero-eyebrow {
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.375rem 0.875rem;
		color: var(--text-muted);
		font-size: 0.875rem;
		background: var(--surface-muted);
	}

	.hero-title {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: 1.04;
		letter-spacing: -0.035em;
		font-weight: 680;
		color: var(--text);
		text-wrap: balance;
	}

	.hero-role {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-muted);
		font-size: 1.125rem;

		.role-dot {
			width: 0.625rem;
			height: 0.625rem;
			border-radius: 999px;
			background: var(--accent);
		}
	}

	.hero-summary {
		color: var(--text);
		font-size: 1.125rem;
		line-height: 1.7;
		max-width: 60ch;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;

		a {
			border: 1px solid var(--border);
			border-radius: 8px;
			padding: 0.625rem 1.125rem;
			background: var(--surface);
			color: var(--text);
			text-decoration: none;

			&:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: var(--accent-muted);
			}
		}

		.btn-resume {
			background: var(--accent);
			border-color: var(--accent);
			color: #ffffff;
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			font-weight: 550;

			&:hover {
				background: var(--accent);
				color: #ffffff;
				opacity: 0.92;
			}

			.badge-formats {
				font-size: 0.72rem;
				background: rgba(255, 255, 255, 0.2);
				padding: 0.15rem 0.4rem;
				border-radius: 4px;
				font-family: var(--font-mono);
			}
		}
	}
</style>
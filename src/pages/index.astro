---
import Layout from '../layouts/Layout.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SkillSection from '../components/SkillSection.astro';
import EducationSection from '../components/EducationSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { resumeData } from '../data/resume.ts';

const { identity, summary, experience, skills, education, certifications, projects } =
	resumeData;

const websiteUrl = identity.website.replace(/\/+$/, '');
const sameAs = identity.links.map((link) => link.url);

const personSchema = {
	'@type': 'Person',
	'@id': `${websiteUrl}/#person`,
	'name': identity.name,
	'jobTitle': identity.title,
	'description': summary.short,
	'url': websiteUrl,
	'email': `mailto:${identity.email}`,
	...((identity.phone && { telephone: identity.phone }) ?? {}),
	'address': { '@type': 'PostalAddress', 'addressLocality': identity.location },
	'sameAs': sameAs,
	'alumniOf': education.map((entry) => ({
		'@type': 'CollegeOrUniversity',
		'name': entry.institution,
	})),
	'knowsAbout': [...new Set(skills.flatMap((category) => category.skills.map((skill) => skill.name)))],
};

const ldJson = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfilePage',
			'@id': `${websiteUrl}/#profile`,
			'name': identity.name,
			'url': `${websiteUrl}/`,
			'about': personSchema,
			'mainEntity': { '@id': `${websiteUrl}/#person` },
		},
		{ ...personSchema, '@id': `${websiteUrl}/#person` },
	],
};
---

<Layout>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-eyebrow">
			<span class="live-status-dot" aria-hidden="true"></span>
			<span>{identity.tagline}</span>
		</div>
		<h1 id="hero-title" class="hero-title">
			{identity.name}
		</h1>
		<div class="hero-role">
			<span class="role-badge">{identity.title}</span>
			<span class="location-badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				{identity.location}
			</span>
		</div>
		<p class="hero-summary">{summary.full}</p>
		<div class="hero-actions">
			<a href="/print/resume" class="btn-resume">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
					<line x1="16" y1="13" x2="8" y2="13"></line>
					<line x1="16" y1="17" x2="8" y2="17"></line>
					<polyline points="10 9 9 9 8 9"></polyline>
				</svg>
				<span>View & Download Resume</span>
				<span class="badge-formats">PDF / TXT</span>
			</a>
			<nav class="hero-links" aria-label="Social and professional profiles">
				{
					identity.links.map(({ label, url }) => (
						<a href={url} target="_blank" rel="noreferrer noopener" class="btn-secondary">
							<span>{label}</span>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon" aria-hidden="true">
								<line x1="7" y1="17" x2="17" y2="7"></line>
								<polyline points="7 7 17 7 17 17"></polyline>
							</svg>
						</a>
					))
				}
			</nav>
		</div>
	</section>

	<div class="main-sections">
		<ExperienceSection items={experience} />
		<ProjectsSection projects={projects} />
		<SkillSection categories={skills} />
		<EducationSection education={education} certifications={certifications} />
		<ContactSection email={identity.email} />
	</div>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(ldJson)} />
</Layout>

<style>
	.main-sections {
		display: flex;
		flex-direction: column;
		gap: 4.5rem;
		padding-bottom: 3rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
		padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem);
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		padding: 0.4rem 0.95rem;
		color: var(--text-muted);
		font-size: 0.875rem;
		font-weight: 500;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.live-status-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--status-live);
		animation: pulse-dot 2.2s infinite ease-in-out;
		flex-shrink: 0;
	}

	.hero-title {
		font-size: clamp(2.75rem, 7vw, 4.75rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
		font-weight: 800;
		color: var(--text);
		text-wrap: balance;
		margin: 0;
	}

	.hero-role {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		flex-wrap: wrap;
	}

	.role-badge {
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--accent);
		letter-spacing: -0.01em;
	}

	.location-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.hero-summary {
		color: var(--text-muted);
		font-size: clamp(1.05rem, 2.2vw, 1.2rem);
		line-height: 1.7;
		max-width: 62ch;
		margin: 0;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.875rem;
		margin-top: 0.75rem;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.btn-resume {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		background: var(--accent);
		border: 1px solid var(--accent);
		color: #ffffff;
		border-radius: var(--radius-sm);
		padding: 0.7rem 1.25rem;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		box-shadow: 0 4px 14px var(--accent-glow);
		transition: var(--transition-fast);

		&:hover {
			background: var(--accent-hover);
			border-color: var(--accent-hover);
			transform: translateY(-2px);
			box-shadow: 0 6px 18px var(--accent-glow);
		}

		&:active {
			transform: scale(0.98);
		}

		.badge-formats {
			font-size: 0.72rem;
			background: rgba(255, 255, 255, 0.22);
			padding: 0.2rem 0.45rem;
			border-radius: 4px;
			font-family: var(--font-mono);
			font-weight: 600;
			letter-spacing: 0.02em;
		}
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.7rem 1.1rem;
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		box-shadow: var(--shadow-sm);
		transition: var(--transition-fast);

		.external-icon {
			color: var(--text-subtle);
			transition: transform 0.2s ease, color 0.2s ease;
		}

		&:hover {
			border-color: var(--accent);
			color: var(--accent);
			background: var(--surface-muted);
			transform: translateY(-2px);
			box-shadow: var(--shadow-md);

			.external-icon {
				color: var(--accent);
				transform: translate(1px, -1px);
			}
		}

		&:active {
			transform: scale(0.98);
		}
	}
</style>

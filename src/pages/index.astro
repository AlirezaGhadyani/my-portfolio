---
import Layout from '../layouts/Layout.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SkillSection from '../components/SkillSection.astro';
import EducationSection from '../components/EducationSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { resumeData } from '../data/resume.ts';

const { identity, summary, experience, skills, education, certifications, projects } =
	resumeData;

const websiteUrl = identity.website.replace(/\/+$/, '');
const sameAs = identity.links.map((link) => link.url);
const editorFilename = `${identity.name.toLowerCase().replace(/\s+/g, '-')}.ts`;

const personSchema = {
	'@type': 'Person',
	'@id': `${websiteUrl}/#person`,
	'name': identity.name,
	'jobTitle': identity.title,
	'description': summary.short,
	'url': websiteUrl,
	'email': `mailto:${identity.email}`,
	...((identity.phone && { telephone: identity.phone }) ?? {}),
	'address': { '@type': 'PostalAddress', 'addressLocality': identity.location },
	'sameAs': sameAs,
	'alumniOf': education.map((entry) => ({
		'@type': 'CollegeOrUniversity',
		'name': entry.institution,
	})),
	'knowsAbout': [...new Set(skills.flatMap((category) => category.skills.map((skill) => skill.name)))],
};

const ldJson = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfilePage',
			'@id': `${websiteUrl}/#profile`,
			'name': identity.name,
			'url': `${websiteUrl}/`,
			'about': personSchema,
			'mainEntity': { '@id': `${websiteUrl}/#person` },
		},
		{ ...personSchema, '@id': `${websiteUrl}/#person` },
	],
};
---

<Layout>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-copy">
		<div class="hero-eyebrow">
			<span class="live-status-dot" aria-hidden="true"></span>
			<span>Available for thoughtful engineering work</span>
		</div>
		<h1 id="hero-title" class="hero-title">
			<span>{identity.name.split(' ')[0]}</span>
			<span>{identity.name.split(' ')[1]}</span>
			<strong>{identity.title}</strong>
		</h1>
		<div class="hero-role">
			<span class="location-badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				{identity.location}
			</span>
		</div>
		<p class="hero-summary">{summary.full}</p>
		<div class="hero-actions">
			<a href="/print/resume" class="btn-resume">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
					<line x1="16" y1="13" x2="8" y2="13"></line>
					<line x1="16" y1="17" x2="8" y2="17"></line>
					<polyline points="10 9 9 9 8 9"></polyline>
				</svg>
				<span>View & Download Resume</span>
				<span class="badge-formats">PDF / TXT</span>
			</a>
			<nav class="hero-links" aria-label="Social and professional profiles">
				{
					identity.links.map(({ label, url }) => (
						<a href={url} target="_blank" rel="noreferrer noopener" class="btn-secondary">
							<span>{label}</span>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon" aria-hidden="true">
								<line x1="7" y1="17" x2="17" y2="7"></line>
								<polyline points="7 7 17 7 17 17"></polyline>
							</svg>
						</a>
					))
				}
			</nav>
		</div>
		</div>
		<div class="hero-visual" aria-label="A snapshot of the engineer's technical toolkit">
			<div class="visual-coordinate">SYS / PROFILE_001 <span>01—05</span></div>
			<div class="editor-window">
				<div class="editor-bar"><span></span><span></span><span></span><b>{editorFilename}</b></div>
				<div class="editor-body">
					<div class="line-numbers" aria-hidden="true">01<br />02<br />03<br />04<br />05<br />06<br />07<br />08</div>
					<pre><code><span class="code-muted">const</span> engineer = &#123;
						<span class="code-key">name</span>: <span class="code-string">'{identity.name}'</span>,
						<span class="code-key">focus</span>: <span class="code-string">'quality'</span>,
						<span class="code-key">stack</span>: [
							<span class="code-string">'{skills[0].skills[0].name}'</span>,
							<span class="code-string">'{skills[1].skills[0].name}'</span>,
							<span class="code-string">'{skills[2].skills[0].name}'</span>
						]
					&#125;;</code></pre>
				</div>
				<div class="editor-status"><span><i></i> systems nominal</span><span>UTF-8 · TypeScript</span></div>
			</div>
			<div class="visual-note"><span class="visual-note-mark">+</span><span>Build with intention.<br />Ship with confidence.</span></div>
		</div>
	</section>

	<div class="main-sections">
		<ExperienceSection items={experience} />
		<ProjectsSection projects={projects} />
		<SkillSection categories={skills} />
		<EducationSection education={education} certifications={certifications} />
		<ContactSection email={identity.email} />
	</div>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(ldJson)} />
</Layout>

<style>
	.main-sections {
		display: flex;
		flex-direction: column;
		gap: clamp(6rem, 11vw, 10rem);
		padding-bottom: 3rem;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(20rem, .95fr);
		align-items: center;
		gap: clamp(3rem, 6vw, 6rem);
		min-height: min(47rem, calc(100vh - 4.5rem));
		padding-block: clamp(5rem, 10vw, 8.5rem) clamp(4rem, 7vw, 6rem);
	}

	.hero-copy { min-width: 0; }

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		padding: 0.4rem 0.95rem;
		color: var(--text-muted);
		font-size: 0.875rem;
		font-weight: 500;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.live-status-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--status-live);
		animation: pulse-dot 2.2s infinite ease-in-out;
		flex-shrink: 0;
	}

	.hero-title {
		display: flex;
		flex-direction: column;
		gap: .15em;
		font-size: clamp(4rem, 8vw, 7rem);
		line-height: .88;
		letter-spacing: -0.075em;
		font-weight: 800;
		color: var(--text);
		text-wrap: balance;
		margin: 1.6rem 0 0;
	}

	.hero-title strong { color: var(--accent); font-size: .22em; line-height: 1.25; letter-spacing: .035em; font-weight: 650; text-transform: uppercase; margin-top: 1.25rem; }
	.hero-visual { position: relative; min-width: 0; padding-top: 2rem; }
	.visual-coordinate { position: absolute; top: 0; right: 0; color: var(--text-subtle); font: 10px var(--font-mono); letter-spacing: .08em; }
	.visual-coordinate span { color: var(--accent); margin-left: 1rem; }
	.editor-window { overflow: hidden; border: 1px solid hsl(217 50% 35% / .55); border-radius: 4px; background: #09111f; box-shadow: 0 30px 90px hsl(220 80% 3% / .55), 0 0 0 1px hsl(217 91% 60% / .06); transform: rotate(1.5deg); }
	.editor-bar, .editor-status { display: flex; align-items: center; gap: .45rem; padding: .75rem 1rem; border-bottom: 1px solid hsl(217 30% 18%); color: #75839b; font: 11px var(--font-mono); }
	.editor-bar b { margin-inline: auto; font-weight: 500; color: #a9b7cc; }
	.editor-bar span { width: 7px; height: 7px; border-radius: 50%; background: #ef6c72; }.editor-bar span:nth-child(2) { background: #e6b45c; }.editor-bar span:nth-child(3) { background: #62c98b; }
	.editor-body { display: flex; padding: 2rem 1.2rem; min-height: 22rem; }
	.line-numbers { width: 2rem; flex: none; color: #3d4d64; text-align: right; font: 12px/2 var(--font-mono); user-select: none; }
	.editor-body pre { margin: 0; padding-left: 1rem; overflow: auto; color: #d9e2f0; font: 12px/2 var(--font-mono); }.editor-body code { white-space: pre-line; }.code-muted { color: #c792ea; }.code-key { color: #82aaff; }.code-string { color: #c3e88d; }
	.editor-status { justify-content: space-between; border: 0; border-top: 1px solid hsl(217 30% 18%); font-size: 10px; }.editor-status i { display: inline-block; width: 6px; height: 6px; margin-right: .3rem; border-radius: 50%; background: #62c98b; }
	.visual-note { display: flex; gap: .7rem; align-items: flex-start; margin: 1.5rem 0 0 2rem; color: var(--text-muted); font: 12px/1.7 var(--font-mono); }.visual-note-mark { color: var(--accent); font-size: 1.5rem; line-height: 1; }

	.hero-role {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		flex-wrap: wrap;
	}

	.role-badge {
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--accent);
		letter-spacing: -0.01em;
	}

	.location-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.hero-summary {
		color: var(--text-muted);
		font-size: clamp(1.05rem, 2.2vw, 1.2rem);
		line-height: 1.7;
		max-width: 62ch;
		margin: 0;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.875rem;
		margin-top: 0.75rem;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.btn-resume {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		background: var(--accent);
		border: 1px solid var(--accent);
		color: #ffffff;
		border-radius: var(--radius-sm);
		padding: 0.7rem 1.25rem;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		box-shadow: 0 4px 14px var(--accent-glow);
		transition: var(--transition-fast);

		&:hover {
			background: var(--accent-hover);
			border-color: var(--accent-hover);
			transform: translateY(-2px);
			box-shadow: 0 6px 18px var(--accent-glow);
		}

		&:active {
			transform: scale(0.98);
		}

		.badge-formats {
			font-size: 0.72rem;
			background: rgba(255, 255, 255, 0.22);
			padding: 0.2rem 0.45rem;
			border-radius: 4px;
			font-family: var(--font-mono);
			font-weight: 600;
			letter-spacing: 0.02em;
		}
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.7rem 1.1rem;
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		box-shadow: var(--shadow-sm);
		transition: var(--transition-fast);

		.external-icon {
			color: var(--text-subtle);
			transition: transform 0.2s ease, color 0.2s ease;
		}

		&:hover {
			border-color: var(--accent);
			color: var(--accent);
			background: var(--surface-muted);
			transform: translateY(-2px);
			box-shadow: var(--shadow-md);

			.external-icon {
				color: var(--accent);
				transform: translate(1px, -1px);
			}
		}

		&:active {
			transform: scale(0.98);
		}
	}

	@media (max-width: 48rem) {
		.hero { grid-template-columns: 1fr; min-height: auto; gap: 3.5rem; }
		.hero-visual { max-width: 38rem; width: 100%; margin-inline: auto; }
		.editor-window { transform: none; }
	}

	@media (max-width: 30rem) {
		.hero-title { font-size: clamp(3.25rem, 17vw, 5rem); }
		.hero-actions, .hero-links { width: 100%; }
		.btn-resume, .btn-secondary { justify-content: center; flex: 1; }
		.editor-body { padding: 1rem .5rem; min-height: 17rem; }
		.editor-body pre { padding-left: .6rem; font-size: 10px; }
	}
</style>

---
import Layout from "../layouts/Layout.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import SkillSection from "../components/SkillSection.astro";
import EducationSection from "../components/EducationSection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import ContactSection from "../components/ContactSection.astro";
import { resumeData } from "../data/resume.ts";

const { identity, summary, experience, skills, education, certifications, projects } = resumeData;

const websiteUrl = identity.website.replace(/\/+$/, "");
const sameAs = identity.links.map((link) => link.url);
const featuredProject = projects.find((project) => project.tier === "flagship") ?? projects[0];
const proofMetrics = featuredProject.impactMetrics ?? [];

const personId = `${websiteUrl}/#person`;
const personSchema = {
	"@type": "Person",
	"@id": personId,
	name: identity.name,
	jobTitle: identity.title,
	description: summary.short,
	url: websiteUrl,
	email: `mailto:${identity.email}`,
	...((identity.phone && { telephone: identity.phone }) ?? {}),
	address: { "@type": "PostalAddress", addressLocality: identity.location },
	sameAs: sameAs,
	alumniOf: education.map((entry) => ({
		"@type": "CollegeOrUniversity",
		name: entry.institution,
	})),
	knowsAbout: [...new Set(skills.flatMap((category) => category.skills.map((skill) => skill.name)))],
};

const ldJson = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ProfilePage",
			"@id": `${websiteUrl}/#profile`,
			name: identity.name,
			url: `${websiteUrl}/`,
			about: { "@id": personId },
			mainEntity: { "@id": personId },
		},
		personSchema,
	],
};
---

<Layout jsonLd={ldJson}>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-kicker">
			<span>Portfolio / 2026</span><span class="kicker-rule" aria-hidden="true"></span><span
				>Independent engineering practice</span
			>
		</div>
		<div class="hero-copy">
			<div class="hero-eyebrow">
				<span class="live-status-dot" aria-hidden="true"></span>
				<span>Available for thoughtful engineering work</span>
			</div>
			<h1 id="hero-title" class="hero-title"><span>{identity.name}</span><strong>{identity.title}</strong></h1>
			<div class="hero-role">
				<span class="location-badge">
					<svg
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					{identity.location}
				</span>
			</div>
			<p class="hero-summary">{summary.full}</p>
			<div class="hero-actions">
				<a href="/print/resume" class="btn-resume">
					<svg
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<line x1="16" y1="13" x2="8" y2="13"></line>
						<line x1="16" y1="17" x2="8" y2="17"></line>
						<polyline points="10 9 9 9 8 9"></polyline>
					</svg>
					<span>View & Download Resume</span>
					<span class="badge-formats">PDF / TXT</span>
				</a>
				<nav class="hero-links" aria-label="Social and professional profiles">
					{
						identity.links.map(({ label, url }) => (
							<a href={url} target="_blank" rel="noreferrer noopener" class="btn-secondary">
								<span>{label}</span>
								<svg
									width="14"
									height="14"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="external-icon"
									aria-hidden="true">
									<line x1="7" y1="17" x2="17" y2="7" />
									<polyline points="7 7 17 7 17 17" />
								</svg>
							</a>
						))
					}
				</nav>
			</div>
		</div>
		<div class="hero-visual" aria-label={`Technical proof from ${featuredProject.title}`}>
			<div class="proof-label"><span class="proof-index">01</span> Featured system</div>
			<div class="code-panel">
				<div class="code-panel-head">
					<span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="code-file"
						>threat-signals.ts</span
					><span class="code-kind">TypeScript</span>
				</div>
				<pre
					aria-label={`Code excerpt for ${featuredProject.title}`}><code><span class="code-muted">const</span> <span class="code-name">signals</span> = <span class="code-muted">await</span> ingest(&#123;
  source: <span class="code-string">'edge-stream'</span>,
  batchSize: <span class="code-number">2_400_000</span>,
&#125;);

<span class="code-muted">return</span> detectThreats(signals)
  .filter(<span class="code-name">isActionable</span>)
  .publish(&#123; latency: <span class="code-string">'p95'</span> &#125;);</code></pre>
				<div class="code-caption">
					<span>{featuredProject.title}</span><a
						href={featuredProject.hasCaseStudy ? `/projects/${featuredProject.slug}` : "#projects"}
						>Read the technical story <span aria-hidden="true">↗</span></a
					>
				</div>
			</div>
			{
				proofMetrics.length > 0 && (
					<ul class="proof-metrics">
						{proofMetrics.slice(0, 3).map((metric) => (
							<li>
								<strong>{metric}</strong>
								<span>measured outcome</span>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>

	<div class="main-sections">
		<ExperienceSection items={experience} />
		<ProjectsSection projects={projects} />
		<SkillSection categories={skills} />
		<EducationSection education={education} certifications={certifications} />
		<ContactSection email={identity.email} />
	</div>
</Layout>

<style>
	.main-sections {
		display: flex;
		flex-direction: column;
		gap: var(--section-space);
		padding-bottom: 2rem;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
		align-items: center;
		gap: clamp(2.5rem, 5vw, 5rem);
		min-height: min(47rem, calc(100vh - 4.5rem));
		padding-block: clamp(2.75rem, 6vw, 5.5rem) clamp(3.5rem, 6vw, 5rem);
	}

	.hero-kicker {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--text-subtle);
		font: 600 0.72rem/1 var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.kicker-rule {
		width: 2.5rem;
		height: 1px;
		background: var(--accent);
	}

	.hero-copy {
		min-width: 0;
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		padding: 0.4rem 0.95rem;
		color: var(--text-muted);
		font-size: 0.875rem;
		font-weight: 500;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.live-status-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: var(--radius-full);
		background: var(--status-live);
		animation: pulse-dot 2.2s infinite ease-in-out;
		flex-shrink: 0;
	}

	.hero-title {
		display: flex;
		flex-direction: column;
		gap: 0.15em;
		font-size: clamp(3.5rem, 7vw, 6.8rem);
		line-height: 0.88;
		letter-spacing: -0.075em;
		font-weight: 800;
		color: var(--text);
		text-wrap: balance;
		margin: 1.8rem 0 0;
	}

	.hero-title strong {
		color: var(--accent);
		font-size: 0.22em;
		line-height: 1.25;
		letter-spacing: 0.035em;
		font-weight: 650;
		text-transform: uppercase;
		margin-top: 1.4rem;
	}
	.hero-visual {
		position: relative;
		min-width: 0;
		padding-top: 1rem;
	}
	.proof-label {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--accent);
		font: 600 0.72rem/1 var(--font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.proof-index {
		color: var(--text-subtle);
	}
	.code-panel {
		margin-top: 1rem;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-lg);
	}
	.code-panel-head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 2.7rem;
		padding: 0 0.9rem;
		border-bottom: 1px solid var(--border-subtle);
		background: var(--surface-muted);
		color: var(--text-subtle);
		font: 600 0.7rem/1 var(--font-mono);
	}
	.window-dots {
		display: flex;
		gap: 0.3rem;
	}
	.window-dots i {
		display: block;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: var(--radius-full);
		background: var(--border);
	}
	.window-dots i:first-child {
		background: var(--accent);
	}
	.code-file {
		color: var(--text-muted);
	}
	.code-kind {
		margin-left: auto;
		color: var(--text-subtle);
	}
	.code-panel pre {
		overflow-x: auto;
		margin: 0;
		padding: clamp(1.25rem, 3vw, 1.8rem);
		color: var(--text-muted);
		font: 0.78rem/1.8 var(--font-mono);
	}
	.code-muted {
		color: var(--text-subtle);
	}
	.code-name {
		color: var(--accent);
	}
	.code-string {
		color: var(--syntax-string);
	}
	.code-number {
		color: var(--syntax-number);
	}
	.code-caption {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 1.25rem;
		border-top: 1px solid var(--border-subtle);
		color: var(--text-muted);
		font-size: 0.78rem;
	}
	.code-caption a {
		color: var(--accent);
		font-weight: 650;
		text-decoration: none;
	}
	.proof-metrics {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
	}
	.proof-metrics li {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.proof-metrics strong {
		color: var(--text);
		font: 700 1.2rem/1.1 var(--font-mono);
	}
	.proof-metrics span {
		color: var(--text-subtle);
		font-size: 0.75rem;
	}
	.proof-link {
		color: var(--accent);
		font-weight: 650;
		text-decoration: none;
	}
	.proof-link:hover {
		color: var(--accent-hover);
	}

	.hero-role {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		flex-wrap: wrap;
	}

	.location-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--text-muted);
		font: 600 0.75rem/1 var(--font-mono);
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.location-badge svg {
		color: var(--accent);
	}

	.hero-summary {
		color: var(--text-muted);
		font-size: clamp(1.05rem, 2.2vw, 1.2rem);
		line-height: 1.7;
		max-width: 62ch;
		margin: 1.25rem 0 0;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.875rem;
		margin-top: 1.5rem;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.btn-resume {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		background: var(--accent);
		border: 1px solid var(--accent);
		color: var(--on-accent);
		border-radius: var(--radius-md);
		padding: 0.7rem 1.25rem;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		box-shadow: 0 4px 14px var(--accent-glow);
		transition: var(--transition-fast);

		&:hover {
			background: var(--accent-hover);
			border-color: var(--accent-hover);
			transform: translateY(-2px);
			box-shadow: 0 6px 18px var(--accent-glow);
		}

		&:active {
			transform: scale(0.98);
		}

		.badge-formats {
			font-size: 0.72rem;
			background: rgba(255, 255, 255, 0.22);
			padding: 0.2rem 0.45rem;
			border-radius: var(--radius-sm);
			font-family: var(--font-mono);
			font-weight: 600;
			letter-spacing: 0.02em;
		}
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: 0.7rem 1.1rem;
		background: var(--surface);
		color: var(--text);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		box-shadow: var(--shadow-sm);
		transition: var(--transition-fast);

		.external-icon {
			color: var(--text-subtle);
			transition:
				transform 0.2s ease,
				color 0.2s ease;
		}

		&:hover {
			border-color: var(--accent);
			color: var(--accent);
			background: var(--surface-muted);
			transform: translateY(-2px);
			box-shadow: var(--shadow-md);

			.external-icon {
				color: var(--accent);
				transform: translate(1px, -1px);
			}
		}

		&:active {
			transform: scale(0.98);
		}
	}

	@media (max-width: 48rem) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			gap: 2.75rem;
		}
		.hero-visual {
			max-width: 42rem;
			width: 100%;
			margin-inline: auto;
		}
	}

	@media (max-width: 35rem) {
		.hero-title {
			font-size: clamp(3.25rem, 17vw, 5rem);
		}
		.hero-actions,
		.hero-links {
			width: 100%;
		}
		.btn-resume,
		.btn-secondary {
			justify-content: center;
			width: 100%;
		}
		.hero-links {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.hero-kicker {
			font-size: 0.65rem;
		}
		.proof-metrics {
			gap: 0.75rem;
		}
		.code-panel pre {
			font-size: 0.7rem;
		}
		.code-caption {
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>

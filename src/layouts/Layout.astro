---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { resumeData } from "../data/resume.ts";
import { themeConfig, paletteIds } from "../data/theme.ts";
import interWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2";
import monoWoff2 from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title = "Jordan Avery — Full-Stack Software Engineer", description, image } = Astro.props;
const metaDescription =
	description ??
	"Portfolio and engineering resume of Jordan Avery: full-stack TypeScript, React, Astro, and edge hosting.";

const siteUrl = resumeData.identity.website.replace(/\/+$/, "");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ? new URL(image, siteUrl).href : `${siteUrl}/og-image.svg`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={metaDescription} />
		<meta name="color-scheme" content="light dark" />
		<link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Jordan Avery" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />
		<title>{title}</title>
		<script is:inline define:vars={{ defaultPalette: themeConfig.defaultPalette, validPalettes: paletteIds }}>
			(function () {
				const root = document.documentElement;
				if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					root.setAttribute("data-motion", "reduced");
				}
				let stored;
				try {
					stored = localStorage.getItem("theme");
				} catch {
					stored = null;
				}
				const dark =
					stored === "dark" ||
					(!stored && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
				root.setAttribute("data-theme", dark ? "dark" : "light");
				let storedPalette;
				try {
					storedPalette = localStorage.getItem("palette");
				} catch {
					storedPalette = null;
				}
				if (!storedPalette || validPalettes.indexOf(storedPalette) === -1) {
					storedPalette = defaultPalette;
					try {
						localStorage.setItem("palette", storedPalette);
					} catch {
						/* preference persistence is optional */
					}
				}
				root.setAttribute("data-palette", storedPalette);
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<SiteHeader />
		<main id="main-content" class="content-shell">
			<slot />
		</main>
		<SiteFooter />

		<script is:inline define:vars={{ defaultPalette: themeConfig.defaultPalette }}>
			document.addEventListener("DOMContentLoaded", () => {
				const root = document.documentElement;
				const buttons = Array.from(document.querySelectorAll("[data-theme-toggle]"));
				const syncLabels = () => {
					const active = root.getAttribute("data-theme") || "dark";
					const target = active === "dark" ? "light" : "dark";
					const label = `Switch to ${target} color theme`;
					buttons.forEach((button) => button.setAttribute("aria-label", label));
				};
				buttons.forEach((themeButton) => {
					if (themeButton.dataset.themeBound) return;
					themeButton.dataset.themeBound = "true";
					themeButton.addEventListener("click", () => {
						const current = root.getAttribute("data-theme") || "dark";
						const next = current === "dark" ? "light" : "dark";
						root.setAttribute("data-theme", next);
						try {
							localStorage.setItem("theme", next);
						} catch {
							/* ignore preference-persistence failure */
						}
						syncLabels();
					});
				});
				syncLabels();
			});
			document.addEventListener("DOMContentLoaded", () => {
				const root = document.documentElement;
				const options = Array.from(document.querySelectorAll("[data-palette-option]"));
				const sync = () => {
					const active = root.getAttribute("data-palette");
					options.forEach((option) =>
						option.setAttribute("aria-pressed", String(option.getAttribute("data-palette-option") === active)),
					);
				};
				const applyPalette = (id, persist) => {
					root.setAttribute("data-palette", id);
					try {
						if (persist) localStorage.setItem("palette", id);
					} catch {
						/* preference persistence is optional */
					}
					document.dispatchEvent(new CustomEvent("palettechange"));
				};
				options.forEach((option) => {
					if (option.dataset.bound) return;
					option.dataset.bound = "true";
					option.addEventListener("click", () => {
						const id = option.getAttribute("data-palette-option");
						if (!id) return;
						applyPalette(id, true);
						option.closest("[data-palette-popup]")?.removeAttribute("open");
					});
				});
				document.querySelectorAll("[data-palette-reset]").forEach((reset) => {
					if (reset.dataset.bound) return;
					reset.dataset.bound = "true";
					reset.addEventListener("click", () => {
						try {
							localStorage.removeItem("palette");
						} catch {
							/* preference persistence is optional */
						}
						applyPalette(defaultPalette, false);
						reset.closest("[data-palette-popup]")?.removeAttribute("open");
					});
				});
				document.addEventListener("palettechange", sync);
				sync();
			});
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		inset-inline-start: 1rem;
		top: 0.75rem;
		z-index: 100;
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius-md);
		background: var(--accent);
		color: var(--on-accent);
		transform: translateY(-150%);
		transition: transform 0.15s ease;

		&:focus-visible {
			transform: translateY(0);
		}
	}

	.content-shell {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
	}
</style>

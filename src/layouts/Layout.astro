---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { resumeData } from '../data/resume.ts';
import { themeConfig, paletteIds } from '../data/theme.ts';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title = 'Jordan Avery — Full-Stack Software Engineer', description, image } = Astro.props;
const metaDescription =
	description ??
	'Portfolio and engineering resume of Jordan Avery: full-stack TypeScript, React, Astro, and edge hosting.';

const siteUrl = resumeData.identity.website.replace(/\/+$/, '');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ? new URL(image, siteUrl).href : `${siteUrl}/og-image.svg`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={metaDescription} />
		<meta name="color-scheme" content="light dark" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Jordan Avery" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />
		<title>{title}</title>
		<script is:inline define:vars={{ defaultPalette: themeConfig.defaultPalette, validPalettes: paletteIds }}>
			(function () {
				var root = document.documentElement;
				if (
					window.matchMedia &&
					window.matchMedia('(prefers-reduced-motion: reduce)').matches
				) {
					root.setAttribute('data-motion', 'reduced');
				}
				var stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch (error) {
					stored = null;
				}
				var dark =
					stored === 'dark' ||
					(stored === null &&
						window.matchMedia &&
						window.matchMedia('(prefers-color-scheme: dark)').matches);
				root.setAttribute('data-theme', dark ? 'dark' : 'light');
				var storedPalette = null;
				try {
					storedPalette = localStorage.getItem('palette');
				} catch (error) {
					storedPalette = null;
				}
				if (!storedPalette || validPalettes.indexOf(storedPalette) === -1) {
					storedPalette = defaultPalette;
					try {
						localStorage.setItem('palette', storedPalette);
					} catch (error) {
						/* preference persistence is optional */
					}
				}
				root.setAttribute('data-palette', storedPalette);
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<SiteHeader />
		<main id="main-content" class="content-shell">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		inset-inline-start: 1rem;
		top: 0.75rem;
		z-index: 100;
		padding: 0.75rem 1.25rem;
		border-radius: 8px;
		background: var(--accent);
		color: #fff;
		transform: translateY(-150%);
		transition: transform 0.15s ease;

		&:focus-visible {
			transform: translateY(0);
		}
	}

	.content-shell {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
	}
</style>
